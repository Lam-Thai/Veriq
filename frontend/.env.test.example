# Environment for running the Playwright DB-backed integration/E2E suite locally against a real
# Postgres (mirrors what `.github/workflows/playwright.yml` does in CI with a `postgres` service
# container). This is NOT a replacement for frontend/.env.local — that file stays pointed at the
# real Supabase dev database and your own Clerk dev keys for `npm run dev`. This file is only for
# `db:test:migrate` / `test:e2e` runs, loaded via `dotenv -e .env.test.local -- <command>`
# (`dotenv-cli` devDependency) so it doesn't touch prisma.config.ts's existing .env.local loading.
#
# cp .env.test.example .env.test.local, then fill in the Clerk keys below — .env.test.local is
# git-ignored, same as .env.local.
#
# Quick start:
#   docker compose --profile postgres up -d   # starts the local test Postgres (see
#                                              # ../docker-compose.yml / ../postgres.env.example)
#   npm run db:test:migrate                   # dotenv -e .env.test.local -- prisma migrate deploy
#   dotenv -e .env.test.local -- npm run test:e2e

# Clerk (https://dashboard.clerk.com/last-active?path=api-keys)
# Use the SAME test-mode keys already in your frontend/.env.local for the shared CI Clerk test
# instance — see README.md's "CI: End-to-end tests" section for how to obtain/confirm them. Do
# not create a second Clerk instance just for local test runs.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Dedicated sign-in / sign-up routes (see app/sign-in, app/sign-up) — same defaults as
# frontend/.env.example.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where Clerk sends users after a successful sign-in / sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Local test PostgreSQL — the `postgres` service in ../docker-compose.yml
# (`docker compose --profile postgres up`), credentials from ../postgres.env
# (see ../postgres.env.example; values below assume its suggested defaults).
# Host port 5433, not 5432, so this doesn't collide with a developer's own local Postgres.
# No pooler locally (unlike the Supabase pooled/direct split in .env.example) — a single
# container needs no PgBouncer, so both vars point at the same connection.
DATABASE_URL="postgresql://veriq_test:veriq_test_not_a_real_password@localhost:5433/veriq_test"
DIRECT_URL="postgresql://veriq_test:veriq_test_not_a_real_password@localhost:5433/veriq_test"

# Everything below this line is required by frontend/lib/env.ts's EnvSchema for `next start` to
# boot, but is NOT exercised by the DB-backed sharing/harness tests. Values match the placeholders
# already used in .github/workflows/playwright.yml's job-level `env:` block, so local test runs
# and CI stay consistent — keep the two in sync if either changes.
STRIPE_SECRET_KEY=sk_test_ci_placeholder_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_ci_placeholder_not_a_real_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_ci_placeholder_not_a_real_key
STRIPE_PRICE_ID_PRO=price_ci_placeholder_pro
STRIPE_PRICE_ID_ENTERPRISE=price_ci_placeholder_enterprise
INTERNAL_JWT_SECRET=ci-placeholder-internal-jwt-secret-not-real
FASTAPI_URL=http://localhost:8000

# Not set below: GEMINI_API_KEY, SENTRY_DSN, NEXT_PUBLIC_SENTRY_DSN, RESEND_API_KEY,
# RESEND_FROM_EMAIL, REPORT_SHARE_IP_SALT — all `.optional()` in lib/env.ts's EnvSchema, so
# `next start` boots fine without them (same as CI's job-level env block, which also omits them).

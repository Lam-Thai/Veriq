// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 removed `url`/`directUrl` from the schema file — connection URLs now
  // live in prisma.config.ts (for the CLI/migration engine) and are passed directly
  // to the driver adapter in lib/db.ts (for the app's runtime client). See:
  // https://pris.ly/d/config-datasource
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subscription        Subscription?
  platformConnections PlatformConnection[]
  incomeNarrative     IncomeNarrative?
  reportJobs          ReportJob[]
  expenses            Expense[]
  reportShares        ReportShare[]

  @@index([clerkId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([stripeCustomerId])
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

// A signed-in user's connection to one mocked income platform (see
// components/landing/platform-data.ts, the source of truth for valid slugs and each platform's
// demo verifiedAmount). One row per connected platform per user — reconnecting the same platform
// upserts this row rather than creating a duplicate.
model PlatformConnection {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String
  verifiedAmount Decimal  @db.Decimal(10, 2)
  connectedAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, slug])
}

// Cached AI-generated (Gemini) descriptive summary of a user's verified income — see
// lib/ai/income-narrative.ts. One row per user. Regenerated when `inputHash` (a hash of the
// user's current per-platform verifiedAmounts) no longer matches the latest connection state, or
// when `generatedAt` is older than the service's staleness window — whichever comes first. This
// exists purely so the dashboard card and the PDF report don't call Gemini on every single page
// load/report download; it is never treated as a source of truth for verifiedAmount itself.
model IncomeNarrative {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Descriptive only — never a credit/lending score. See lib/prompts/income-narrative.ts.
  narrative              String
  stabilityRating        String
  trendDirection         String
  diversificationSummary String
  notableObservations    String[]

  // sha256 of the sorted `slug:verifiedAmount` pairs used to generate this row — see
  // lib/ai/income-narrative.ts's computeInputHash. Changes whenever a connection is added,
  // removed, or its verifiedAmount changes.
  inputHash   String
  generatedAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

enum ReportJobStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// Tracks an async PDF-report render so app/api/report/route.tsx never blocks a request/
// serverless invocation on `renderToBuffer` (see README's "Where new work goes" section) — the
// POST route creates this row and schedules the render via Next.js's `after()`, and
// app/api/report/[jobId]/route.ts polls it. `pdfData` is stored inline (Postgres bytea) rather
// than in object storage: report sizes here are small (a text/table PDF, no images) and this
// avoids adding a new storage dependency for a foundational-scale fix — revisit if report
// size/volume ever makes that impractical. The row (and its `pdfData`) is kept permanently — a
// READY job's PDF is re-downloadable indefinitely from the dashboard's Report history, a
// deliberate reversal of this model's earlier short-TTL-then-clear-bytes lifecycle. Revisit
// (e.g. move `pdfData` to object storage) if report volume ever makes indefinite inline retention
// impractical.
model ReportJob {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         ReportJobStatus @default(PENDING)
  // Raw `platforms` query param from the request that created this job, re-applied by the after()
  // callback so the rendered subset always matches what the caller asked for.
  platformsParam String?
  pdfData        Bytes?
  filename       String?
  error          String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  shares         ReportShare[]

  // Covers both getLastReportValidUntil/createReportJobIfAllowed's
  // { userId, status: {in:[...]} } filter and getReportHistory's { userId } lookup, both ordered
  // by createdAt desc — an index-only scan instead of a post-scan sort on two hot paths (report
  // creation gate + every dashboard load).
  @@index([userId, status, createdAt(sort: Desc)])
}

// A self-employed/gig user's tracked business expense, used by the dashboard's "Expenses" tab to
// derive net (after-expense) income and an estimated deductible total. Complements
// PlatformConnection's *gross* verified income — nothing here ever feeds the verification pipeline;
// every figure built from it is an informational planning estimate, not a tax filing (see
// lib/expense-calculators.ts). Amounts are Decimal (never Float) so cents never drift. Soft-deleted
// via `deletedAt` (matching the schema-wide convention) so a removed row can't resurface in totals
// but history is never hard-destroyed. `date` is the user-chosen date the expense occurred (what
// monthly grouping keys on), distinct from `createdAt` (when the row was written).
model Expense {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal         @db.Decimal(10, 2)
  category   ExpenseCategory
  date       DateTime        @db.Timestamptz(3)
  note       String?         @db.VarChar(280)
  // Whether the user considers this expense tax-deductible. Defaults true (most tracked business
  // expenses are), user-overridable per row; drives the "estimated deductible total".
  deductible Boolean         @default(true)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime?       @db.Timestamptz(3)

  // Serves the only list query: a per-user, not-soft-deleted scan ordered by `date` desc (keyset
  // paginated). `deletedAt` sits in the key so the `deletedAt IS NULL` filter is covered rather
  // than applied as a post-scan filter. Category filtering is an additional predicate on top.
  @@index([userId, deletedAt, date(sort: Desc)])
}

// Common gig/self-employed expense buckets. Enum (never a raw string) so the value set is fixed and
// type-safe end to end; labels for display live in lib/expenses.ts, never in the DB.
enum ExpenseCategory {
  VEHICLE_MILEAGE
  SUPPLIES
  PLATFORM_FEES
  PHONE_INTERNET
  HOME_OFFICE
  OTHER
}

model ReportShare {
  id            String    @id @default(cuid())
  reportJobId   String
  reportJob     ReportJob @relation(fields: [reportJobId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // sha256 hex digest of the raw bearer token minted at creation. The raw token is returned once
  // in the create response and never persisted — a DB-only exposure yields no live credentials.
  tokenHash     String    @unique @db.VarChar(64)

  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  // Set exactly once, atomically, by the first successful /verify view. Doubles as the
  // first-view email race guard. Null = never viewed.
  firstViewedAt DateTime? @db.Timestamptz(3)

  views         ReportShareView[]

  // Serves listSharesForUser's { userId } scan for the dashboard tab, newest first.
  @@index([userId, createdAt(sort: Desc)])
  // Serves the cap-of-10 count query: { reportJobId, revokedAt: null, expiresAt: { gt: now } }.
  @@index([reportJobId, revokedAt, expiresAt])
}

model ReportShareView {
  id            String      @id @default(cuid())
  reportShareId String
  reportShare   ReportShare @relation(fields: [reportShareId], references: [id], onDelete: Cascade)
  viewedAt      DateTime    @default(now()) @db.Timestamptz(3)
  // sha256(salt + coarsened IP). Never a raw or plaintext-coarse IP. Null if no salt is
  // configured or no IP header was present.
  ipHash        String?     @db.VarChar(64)
  userAgent     String?     @db.VarChar(300)

  // Serves the per-link view-log query: { reportShareId }, ordered by viewedAt desc.
  @@index([reportShareId, viewedAt(sort: Desc)])
}

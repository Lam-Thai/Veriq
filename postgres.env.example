# Used only by the optional `postgres` service in docker-compose.yml
# (docker compose --profile postgres up) — the ephemeral local Postgres the
# Playwright integration/E2E suite runs against. Throwaway/local only, never
# a real dev or prod database (that's Supabase — see frontend/.env.example).
#
# cp postgres.env.example postgres.env, then fill in your own local values —
# postgres.env is git-ignored, same as backend/.env and frontend/.env.local.
# The values below are the suggested defaults; frontend/.env.test.example's
# DATABASE_URL/DIRECT_URL assume you used them as-is. If you change them
# here, update frontend/.env.test.local to match.
POSTGRES_USER=veriq_test
# Not a secret — throwaway local-only credential for an ephemeral, non-persisted container (see
# docker-compose.yml). Named with a "not_a_real_*" suffix, matching this repo's convention for
# placeholder credentials elsewhere (.github/workflows/playwright.yml), so it reads as an obvious
# placeholder to both a human and a generic-secret scanner.
POSTGRES_PASSWORD=veriq_test_not_a_real_password
POSTGRES_DB=veriq_test
